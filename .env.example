# ── Firebase (Firebase Console → Project settings → Your apps → Web app) ──
# Public by design; data is protected by firestore.rules / storage.rules.
# Leave empty to run without sign-in: Hero, Today's Choice (demo) and Shopping still work.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Weather (server only; leave empty to use mock weather) ──
WEATHER_PROVIDER=mock            # openweathermap | cwa | mock
OPENWEATHER_API_KEY=
CWA_API_KEY=

# ── Official website search (server only; leave empty to use the mock provider) ──
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# ── Smart lookup (server only). v1 uses the demo catalogue (mock); a licensed data source plugs in here later. ──
FRAGRANCE_LOOKUP_PROVIDER=mock
