rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each member can read and write only their own profile, collection and usage logs.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
